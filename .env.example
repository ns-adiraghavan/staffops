# Copy to .env and fill in. Nothing here is required for the default
# (local-file) setup — the server runs as-is.

# Server port
PORT=8080

# --- Frontend ---
# Turn on API sync so the browser reads/writes shared server state instead
# of per-browser localStorage. Leave unset for a static (Vercel) deploy.
# VITE_API=1

# --- Storage backend ---
# file  = local JSON at server/data/state.json (default, zero setup, no cost)
# drive = Google Drive (no incremental cost — included with Google Workspace)
STORAGE=file

# --- Google Drive (only when STORAGE=drive) ---
# Path to the service-account JSON key file on the server (never commit it).
# GOOGLE_APPLICATION_CREDENTIALS=./service-account.json
# The shared NS StaffOps Drive folder id. Share that folder with the service
# account's client_email as Editor.
# GDRIVE_FOLDER_ID=

# Optional: where the file adapter writes (defaults to server/data)
# DATA_DIR=./server/data
